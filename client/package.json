{
  "name": "record-ranks",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev -p $(grep -E '^PORT=' .env | sed -r 's/^PORT=([0-9]+).*/\\1/')",
    "build": "next build",
    "start": "next start",
    "check": "pnpm exec biome check",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "server-only-off": "find \"./\" -type f -name \"*.ts\" -exec sed -i \"s/^import \\\"server-only\\\";$/\\/\\/ import \\\"server-only\\\";/\" {} +",
    "server-only-on": "find \"./\" -type f -name \"*.ts\" -exec sed -i \"s/^\\/\\/ import \\\"server-only\\\";$/import \\\"server-only\\\";/\" {} +",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "auth:substitute-config": "sed -E \"s/\\.\\.\\.\\(IS_RR_INSTANCE \\/\\/.*auth:generate.*$/...(true/\" server/auth.ts > auth.temp.ts",
    "auth:generate": "pnpm auth:substitute-config && pnpm exec auth generate --config auth.temp.ts --output ./server/db/schema/auth-schema.ts ; rm auth.temp.ts",
    "stripe:wh-listen": "stripe listen --forward-to localhost:3000/api/auth/stripe/webhook --api-key $(grep -E '^STRIPE_SECRET_KEY=' .env | sed -r 's/^STRIPE_SECRET_KEY=\"([^\"]+)\"$/\\1/')"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.29",
    "@better-auth/drizzle-adapter": "1.6.29",
    "@better-auth/stripe": "1.6.29",
    "@cubing/icons": "3.0.5",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/env": "16.2.9",
    "@next/mdx": "16.2.9",
    "@supabase/storage-js": "2.115.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-virtual": "3.14.9",
    "@trustcomponent/trustcaptcha-nodejs": "3.0.0",
    "@trustcomponent/trustcaptcha-react": "3.0.2",
    "better-auth": "1.6.29",
    "bootstrap": "5.3.8",
    "country-flag-icons": "1.6.20",
    "csv-parse": "7.0.3",
    "cubing": "0.63.4",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "drizzle-orm": "1.0.0-rc.3",
    "geo-tz": "8.1.8",
    "handlebars": "4.7.9",
    "jszip": "3.10.1",
    "lodash": "4.18.1",
    "next": "16.2.9",
    "next-safe-action": "8.7.1",
    "nodemailer": "10.0.0",
    "nuqs": "2.10.1",
    "pino": "10.3.1",
    "pino-logflare": "0.5.2",
    "postcss": "8.5.28",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-datepicker": "9.1.0",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remove-accents": "0.5.0",
    "server-only": "0.0.1",
    "stripe": "22.5.0",
    "swr": "2.5.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@electric-sql/pglite": "0.5.8",
    "@iconify-json/logos": "1.2.13",
    "@iconify-json/streamline-logos": "1.2.0",
    "@iconify-json/tabler": "1.2.38",
    "@iconify/tailwind4": "1.2.3",
    "@types/lodash": "4.17.25",
    "@types/mdx": "2.0.14",
    "@types/node": "24.10.9",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "auth": "1.6.29",
    "drizzle-kit": "1.0.0-rc.3",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
